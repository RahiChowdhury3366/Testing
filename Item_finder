-- 7. ITEM COLLECTOR (NORMAL MODE / TELEPORT & PICKUP)
--==============================================================--
local function CollectItem(Item)
    if not Item or not Item.Parent or not Item:IsDescendantOf(Workspace) then return end

    local Character = Player.Character
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local ClickDetector = Item:FindFirstChildWhichIsA("ClickDetector")

    if not Character then return end
    if not ClickDetector then return end
    if not HRP or not Humanoid then return end
    
    -- saving player
    local OldCFrame = HRP.CFrame

    -- Teleport to item safely
    HRP.Anchored = true
    HRP.CFrame = (Item:IsA("BasePart") and Item.CFrame or Item:GetPivot()) + Vector3.new(0, 3, 0)
    task.wait(0.05)
    HRP.Anchored = false

    -- Interact with item
    local StartTime = os.clock()
    while Item and Item.Parent and Item:IsDescendantOf(Workspace) do
        fireclickdetector(ClickDetector)
        task.wait(0.01)
        if os.clock() - StartTime >= 2 then break end
    end

    -- Teleport back and reset movement control
    HRP.Anchored = true
    HRP.CFrame = OldCFrame
    task.wait(0.05)
    HRP.Anchored = false

    HRP.AssemblyLinearVelocity = Vector3.zero
    HRP.AssemblyAngularVelocity = Vector3.zero
    Humanoid:ChangeState(Enum.HumanoidStateType.Running)
end



-- Extra helper function to ensure the tool is equipped in hand for unlocking door
local function EquipingTheTool(ItemName)
    local Character = Player.Character
    local Backpack = Player:FindFirstChild("Backpack")
    if not Character then return nil end

    -- Check if tool is already equipped
    for _, tool in ipairs(Character:GetChildren()) do
        if tool:IsA("Tool") then
            return tool
        end
    end

    -- Search backpack and equip
    if Backpack then
        for _, tool in ipairs(Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local name = IdentifyPiggyItem and IdentifyPiggyItem(tool) or tool.Name
                if string.lower(tostring(name)) == string.lower(tostring(ItemName)) or string.find(string.lower(tool.Name), string.lower(ItemName)) then
                    tool.Parent = Character
                    return tool
                end
            end
        end
    end

    return Character:FindFirstChildOfClass("Tool")
end

