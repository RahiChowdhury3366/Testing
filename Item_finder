local function CreateButton(Item)
    if not Item or ItemButtons[Item] then return end

    local Button = Instance.new("TextButton")
    ItemButtons[Item] = Button
    Button.Parent = ScrollingFrame
    Button.Size = UDim2.new(0, 100, 0, 70)
    Button.BackgroundColor3 = Color3.fromRGB(21, 18, 29)
    Button.BorderSizePixel = 0
    Button.Text = ""

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.Parent = Button
    ButtonCorner.CornerRadius = UDim.new(0, 12)

    local Stroke = Instance.new("UIStroke")
    Stroke.Parent = Button
    Stroke.Thickness = 1
    Stroke.Color = Color3.fromRGB(52, 43, 73)

    local View = Instance.new("ViewportFrame")
    View.Parent = Button
    View.Size = UDim2.new(1, -12, 0, 40)
    View.Position = UDim2.new(0, 4, 0, 3)
    View.BackgroundTransparency = 1
    View.ClipsDescendants = true

    pcall(function()
        local Clone = Item:Clone()
        Clone.Parent = View
        if Clone:IsA("BasePart") then
            Clone.Anchored = true
            Clone.CFrame = CFrame.new(0, 0, 0)
        end
        local Camera = Instance.new("Camera")
        Camera.Parent = View
        View.CurrentCamera = Camera
        local Size = Clone:IsA("BasePart") and Clone.Size or Vector3.new(2, 2, 2)
        local Biggest = math.max(Size.X, Size.Y, Size.Z)
        Camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, math.max(Biggest * 1, 3)), Vector3.new(0, 0, 0))
    end)

    local NameLabel = Instance.new("TextLabel")
    NameLabel.Parent = Button
    NameLabel.Size = UDim2.new(1, -10, 0, 16)
    NameLabel.Position = UDim2.new(0, 5, 1, -20)
    NameLabel.BackgroundTransparency = 1
    NameLabel.Font = Enum.Font.GothamMedium
    NameLabel.TextColor3 = Color3.fromRGB(141, 140, 153)
    NameLabel.TextSize = 11
    NameLabel.Text = string.upper(tostring(IdentifyPiggyItem(Item)))

    -- Button Click Event
    TrackConnection(Button.MouseButton1Click:Connect(function()
        if not ItemFinderAlive then return end
        
        if CurrentMode == "Collector" then
            CollectItem(Item)
        elseif CurrentMode == "Unlocker" then
            UnlockItem(Item)
        end
    end))
end








-- MAIN SCANNER & REFRESH LOOP
local function RefreshItems()
    for item, btn in pairs(ItemButtons) do
        if not item or not item.Parent then
            if btn then btn:Destroy() end
            ItemButtons[item] = nil
        end
    end

    local allObjects = ScanAllClickables()
    local validItems = ItemFilter(allObjects)

    for _, item in ipairs(validItems) do
        CreateButton(item)
    end

    UpdateStats()
end

-- Run the scanner continuously in the background
task.spawn(function()
    while ItemFinderAlive do
        pcall(RefreshItems)
        task.wait(2)
