						UnlockSound = UnlockSound or Child
					end
				end

				local isHouseHammer =
					CurrentMap == "House"
					and (Object.Position - Vector3.new(27.621645, 41.469799, -42.1999512)).Magnitude < 4

				if isHouseHammer or SoundCount <= 2 then
					table.insert(LockedDoors, {
						Part = Object,
						Model = Model,
						ClickDetector = ClickDetector,
						Sound = isHouseHammer and nil or UnlockSound
					})
				end
			end
		end
	end

	for _, Object in ipairs(workspace:GetDescendants()) do
		if Object:IsA("Model")
			and Object:FindFirstChild("Humanoid")
			and Object:FindFirstChild("HumanoidRootPart")
