	Button.Parent = ScrollingFrame
	Button.Size = UDim2.new(1, 0, 1, 0)
	Button.BackgroundColor3 = Color3.fromRGB(21, 18, 29)
	Button.BorderSizePixel = 0
	Button.AutoButtonColor = true
	Button.Text = ""

	local ButtonCorner = Instance.new("UICorner")
	ButtonCorner.Parent = Button
	ButtonCorner.CornerRadius = UDim.new(0, 12)

	local Stroke = Instance.new("UIStroke")
	Stroke.Parent = Button
	Stroke.Thickness = 1
	Stroke.Color = Color3.fromRGB(52, 43, 73)

	------------------------------------------------
	-- 3D Preview
	------------------------------------------------

	local View = Instance.new("ViewportFrame")
	View.Parent = Button
	View.Size = UDim2.new(1, -20, 0, 94)
	View.Position = UDim2.new(0, 10, 0, -20)
	View.BackgroundTransparency = 1
	View.BorderSizePixel = 0

	local Clone = Item:Clone()
	Clone.Parent = View

	local Camera = Instance.new("Camera")
	Camera.Parent = View
	View.CurrentCamera = Camera

	local ObjectPosition = Clone.Position
	local CameraPosition = ObjectPosition + Vector3.new(0, 3, 0)
	Camera.CFrame = CFrame.new(CameraPosition, ObjectPosition)

