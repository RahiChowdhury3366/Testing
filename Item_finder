--4 All scanner. all Clickables Obj
local function ScanAllClickables()
    local Obj = {}
    local trackedObjects = {}
    
    for _, desc in ipairs(Workspace:GetDescendants()) do
        local targetObject = nil
        local detector = nil
        
        if desc:IsA("ClickDetector") and desc.Parent then
            targetObject = desc.Parent
            detector = desc
        else
            detector = desc:FindFirstChildOfClass("ClickDetector")
            if detector then
                targetObject = desc
            end
        end
        
        if targetObject and detector and not trackedObjects[targetObject] then
            trackedObjects[targetObject] = true
            table.insert(Obj, {
                Name = targetObject.Name,
                Object = targetObject,
                Detector = detector
            })
        end
    end
    
    return Obj
end

-- Helper function to check if an object/model is visible for Item filter
local function IsVisible(object)
    if not object then return false end

    if object:IsA("BasePart") then
        return object.Transparency < 0.9 and object.LocalTransparencyModifier < 0.9
    elseif object:IsA("Model") then
        local mainPart = object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
        if mainPart then
            return mainPart.Transparency < 0.9 and mainPart.LocalTransparencyModifier < 0.9
        end
    end

    return true
end

-- 5. Item Filter
local function ItemFilter(Obj)
    local Item = {}
    for _, entry in ipairs(Obj) do
        local obj = entry.Object
        local pickupScript = obj:FindFirstChild("ItemPickupScript") or (obj.Name == "ItemPickupScript" and obj)
        
        -- Verify pickupScript exists BEFORE reading its Parent
        if pickupScript and pickupScript.Parent then
            local targetItem = pickupScript.Parent
            local clickDetector = targetItem:FindFirstChild("ClickDetector")

            -- Ensure item has a ClickDetector AND is visible
            if clickDetector and IsVisible(targetItem) then
                table.insert(Item, targetItem)
            end
        end
    end
    return Item
end


