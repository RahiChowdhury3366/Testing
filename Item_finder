-- Item original name finder
local GetItemDetails

GetItemDetails = function(Item)
	local Details = {}

	if not Item then
		return "Item=nil"
	end

	table.insert(Details, "Name=" .. tostring(Item.Name))
	table.insert(Details, "Class=" .. tostring(Item.ClassName))

	local SurfaceGui = Item:FindFirstChildWhichIsA("SurfaceGui", true)
	if SurfaceGui then
		table.insert(Details, "HasSurfaceGui=true")
	end

	local Mesh = Item:FindFirstChildWhichIsA("SpecialMesh", true)
	if Mesh then
		table.insert(Details, "MeshId=" .. tostring(Mesh.MeshId or ""))
		table.insert(Details, "TextureId=" .. tostring(Mesh.TextureId or ""))

		local Part = Mesh.Parent
		if Part and Part:IsA("BasePart") then
			table.insert(Details, "BrickColor=" .. tostring(Part.BrickColor.Name))
			table.insert(Details, "Color=" .. tostring(Part.Color))
			table.insert(Details, "Size=" .. tostring(Part.Size))
			table.insert(Details, "Material=" .. tostring(Part.Material))
		end
	end

	local Part = Item:IsA("BasePart") and Item or Item:FindFirstChildWhichIsA("BasePart", true)
	if Part then
		table.insert(Details, "PartColor=" .. tostring(Part.BrickColor.Name))
		table.insert(Details, "PartSize=" .. tostring(Part.Size))
		table.insert(Details, "PartMaterial=" .. tostring(Part.Material))
	end

	return table.concat(Details, " | ")
end

