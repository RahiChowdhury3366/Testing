--========================--
-- RESTART-SAFE SYSTEM
-- Running the script again
-- will clean the old one first
--========================--
if _G.ItemFinderCleanup then
	pcall(_G.ItemFinderCleanup)
end

local ItemFinderConnections = {}
local ItemFinderAlive = true
local function TrackConnection(connection)
	table.insert(ItemFinderConnections, connection)
	return connection
end
_G.ItemFinderCleanup = function()
	ItemFinderAlive = false
	-- Disconnect saved connections
	for _, connection in ipairs(ItemFinderConnections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(ItemFinderConnections)
	-- Destroy old GUI
	local OldGui = PlayerGui:FindFirstChild("ItemFinder")
	if OldGui then
		OldGui:Destroy()
	end
end
-- Destroy any old GUI just in case
local OldGui = PlayerGui:FindFirstChild("ItemFinder")

