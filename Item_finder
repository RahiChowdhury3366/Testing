local RecordedDoors = {}

local function RecordDoor(MapName, ItemName, DoorPosition)
	if not MapName or not ItemName or not DoorPosition then
		return
	end

	RecordedDoors[MapName] = RecordedDoors[MapName] or {}
	RecordedDoors[MapName][ItemName] = RecordedDoors[MapName][ItemName] or {}

	local List = RecordedDoors[MapName][ItemName]

	-- Don't save duplicates
	for _, Pos in ipairs(List) do
		if (Pos - DoorPosition).Magnitude < 1 then
			return
		end
	end

	table.insert(List, DoorPosition)

	------------------------------------------------
	-- Build Lua
	------------------------------------------------

	local Output = ""

	for Map, Items in pairs(RecordedDoors) do

		Output ..= Map .. " = {\n"

		local ItemNames = {}

		for Name in pairs(Items) do
			table.insert(ItemNames, Name)
		end

		table.sort(ItemNames)

		for _, Name in ipairs(ItemNames) do

			Output ..= "\n\t" .. Name .. " = {\n"

			for _, Pos in ipairs(Items[Name]) do

				Output ..=
					string.format(
						"\t\tVector3.new(%.6f, %.6f, %.6f),\n",
						Pos.X,
						Pos.Y,
						Pos.Z
					)

			end

			Output ..= "\t},\n"

		end

		Output ..= "},\n\n"

	end

	pcall(function()
		setclipboard(Output)
	end)

	print(Output)
	warn("Door table copied to clipboard.")
end

