local function UnlockDoor(Item)
    if not Item or not Item.Parent or not Item:IsDescendantOf(Workspace) then return end
    local Character = Player.Character
    if not Character then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local ItemDetector = Item:FindFirstChildWhichIsA("ClickDetector")
    if not HRP or not Humanoid or not ItemDetector then return end


    local ItemName = IdentifyPiggyItem(Item)
    if not ItemName then return end
    local CurrentMap = GetCurrentMap()
    if not CurrentMap or not SavedDoors[CurrentMap] then return end
    local DoorPositions = SavedDoors[CurrentMap][ItemName]
    if not DoorPositions then return end

    -- Save starting CFrame ONCE
    local OldCFrame = HRP.CFrame

    -- STEP 1: Teleport to Item & Pick it up
    HRP.Anchored = true
    HRP.CFrame = (Item:IsA("BasePart") and Item.CFrame or Item:GetPivot()) + Vector3.new(0, 3, 0)
    task.wait(0.03)
    HRP.Anchored = false

    -- Wait ONLY until item enters inventory
    local StartTime = os.clock()
    while Item and Item.Parent and Item:IsDescendantOf(Workspace) do
        fireclickdetector(ItemDetector)
        task.wait(0.01)
        if os.clock() - StartTime >= 1.5 then break end
    end

    -- STEP 2: Equip tool immediately into hand
    local Tool = EquipingTheTool(ItemName)

    -- Track item removal notification
    if Tool and not DoorStatusConnections[Tool] then
        local toolConnection
        toolConnection = Tool.AncestryChanged:Connect(function(_, parent)
            if not parent then
                if toolConnection then
                    toolConnection:Disconnect()
                    toolConnection = nil
                end
                DoorStatusConnections[Tool] = nil

                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "Item Removed",
                        Text = string.upper(ItemName) .. " no longer in inventory!",
                        Duration = 2
                    })
                end)
            end
        end)

        DoorStatusConnections[Tool] = toolConnection
        table.insert(ItemFinderConnections, toolConnection)
    end

    -- STEP 3: Teleport DIRECTLY to door location(s) without returning home first
    for _, DoorPos in ipairs(DoorPositions) do
local FoundClickDetectors = {}
local clickables = ScanAllClickables()

for _, entry in ipairs(clickables) do
    local obj = entry.Object
    local cd = entry.Detector
    if obj then
        local pos = obj:IsA("BasePart") and obj.Position or (obj:IsA("Model") and obj:GetPivot().Position)
        if pos and (pos - DoorPos).Magnitude <= 10 then
            table.insert(FoundClickDetectors, cd)
        end
    end
end


        if #FoundClickDetectors > 0 then
            local TargetCFrame = CFrame.new(DoorPos + Vector3.new(0, 2, 0))

            HRP.Anchored = true
            HRP.CFrame = TargetCFrame
            task.wait(0.03)
            HRP.Anchored = false

            -- Fast reach check
            local ReachStart = os.clock()
            while (HRP.Position - DoorPos).Magnitude > 10 and (os.clock() - ReachStart) < 0.3 do
                HRP.CFrame = TargetCFrame
                task.wait(0.01)
            end

            -- Fire click detectors on all locks/planks found
            if (HRP.Position - DoorPos).Magnitude <= 10 then
                for _, Detector in ipairs(FoundClickDetectors) do
                    fireclickdetector(Detector)
                    task.wait(0.005)
                    fireclickdetector(Detector)
                    task.wait(0.005)
                    fireclickdetector(Detector)

                    if not DoorStatusConnections[Detector] then
                        local connection
                        local function OnRemoved()
                            if connection then
                                connection:Disconnect()
                                connection = nil
                            end
                            DoorStatusConnections[Detector] = nil

                            pcall(function()
                                StarterGui:SetCore("SendNotification", {
                                    Title = "Door Status",
                                    Text = string.upper(ItemName) .. " door unlocked!",
                                    Duration = 2.5
                                })
                            end)
                        end

                        connection = Detector.AncestryChanged:Connect(function(_, parent)
                            if not parent then
                                OnRemoved()
                            end
                        end)

                        DoorStatusConnections[Detector] = connection
                        table.insert(ItemFinderConnections, connection)
                    end
                end
            end
        end
    end

    -- STEP 4: Return to initial position after everything is complete
    HRP.Anchored = true
    HRP.CFrame = OldCFrame
    task.wait(0.03)
    HRP.Anchored = false

    HRP.AssemblyLinearVelocity = Vector3.zero
    HRP.AssemblyAngularVelocity = Vector3.zero
    Humanoid:ChangeState(Enum.HumanoidStateType.Running)
end




