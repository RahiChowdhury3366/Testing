ItemTypeCount = ItemTypeCount or {}
local function GetDisplayName(BaseName)
	ItemTypeCount[BaseName] = (ItemTypeCount[BaseName] or 0) + 1

	local Count = ItemTypeCount[BaseName]
	if Count > 1 then
		return BaseName .. " (" .. Count .. ")"
	end
	return BaseName
end

