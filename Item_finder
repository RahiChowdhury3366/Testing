local function UpdateModeUI()
	if CurrentMode == "Unlocker" then
		UnlockerTab.BackgroundColor3 = Color3.fromRGB(50, 40, 74)
		UnlockerTab.TextColor3 = Color3.fromRGB(235, 225, 252)
		CollectorTab.BackgroundColor3 = Color3.fromRGB(29, 24, 38)
		CollectorTab.TextColor3 = Color3.fromRGB(168, 160, 179)
		Title.Text = "ITEM FINDER"
		if StatsLabel then
			StatsLabel.Text = "Doors Found: " .. tostring(#LockedDoors)
		end
	else
		UnlockerTab.BackgroundColor3 = Color3.fromRGB(29, 24, 38)
		UnlockerTab.TextColor3 = Color3.fromRGB(168, 160, 179)
		CollectorTab.BackgroundColor3 = Color3.fromRGB(50, 40, 74)
		CollectorTab.TextColor3 = Color3.fromRGB(235, 225, 252)
		Title.Text = "ITEM FINDER"
		if StatsLabel then
			StatsLabel.Text = "Items Found: " .. tostring(#FoundItems)
		end
	end
end

function UpdateStats()
	if not StatsLabel then
		return
	end

	if CurrentMode == "Unlocker" then
		StatsLabel.Text = "Doors Found: " .. tostring(#LockedDoors)
	else
		StatsLabel.Text = "Items Found: " .. tostring(#FoundItems)
	end
end

UnlockerTab.MouseButton1Click:Connect(function()
	CurrentMode = "Unlocker"
	UpdateModeUI()
end)

CollectorTab.MouseButton1Click:Connect(function()
	CurrentMode = "Collector"
	UpdateModeUI()
end)

UpdateModeUI()

