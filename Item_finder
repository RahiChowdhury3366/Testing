local ScanQueued = false

local function SyncItems()

	local CurrentItems = {}

	table.clear(FoundItems)
	table.clear(ItemTypeCount)

	for _, Object in ipairs(Workspace:GetDescendants()) do
		
		if IsPickup(Object) then
			
			local Item = Object.Parent
			
			CurrentItems[Item] = true
			table.insert(FoundItems, Item)

			-- Create new button
			if not ItemButtons[Item] then
				CreateButton(Item)
			end
			
		end
	end


	-- Remove deleted items
	for Item, Button in pairs(ItemButtons) do
		
		if not CurrentItems[Item] or not Item:IsDescendantOf(Workspace) then
			
			Button:Destroy()
			ItemButtons[Item] = nil
			
		end
		table.clear(ItemTypeCount)
	end

	UpdateStats()
end


local function QueueScan()

	if ScanQueued then
		return
	end

	ScanQueued = true

	task.delay(0.2, function()
		
		ScanQueued = false
		
		SyncItems()
		
	end)

end

TrackConnection(
	Workspace.DescendantAdded:Connect(QueueScan)
)

TrackConnection(
	Workspace.DescendantRemoving:Connect(QueueScan)
