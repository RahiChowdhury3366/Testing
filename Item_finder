local function CopyUnknown(Item)
	local Mesh = Item:FindFirstChildWhichIsA("SpecialMesh", true)
	if not Mesh then
		return
	end

	local MeshId = tostring(Mesh.MeshId or "")
	local TextureId = tostring(Mesh.TextureId or "")

	local Part = Mesh.Parent
	local Extra = ""

	if Part and Part:IsA("BasePart") then
		Extra ..= '\nlocal Part = Mesh.Parent'
		Extra ..= '\nif Part and Part:IsA("BasePart") then'

		if Part.BrickColor then
			Extra ..= '\n\tif Part.BrickColor == BrickColor.new("' .. Part.BrickColor.Name .. '") then'
			Extra ..= '\n\t\treturn "UnknownItem"'
			Extra ..= '\n\tend'
		end

		Extra ..= '\nend'
	end

	local Code

	if TextureId ~= "" then
		Code =
'-- Unknown Item\n' ..
'if string.find(MeshId, "' .. MeshId:match("%d+") .. '", 1, true)\n' ..
'and string.find(tostring(Mesh.TextureId), "' .. TextureId:match("%d+") .. '", 1, true) then' ..
Extra ..
'\n\treturn "UnknownItem"\nend\n'
	else
		Code =
'-- Unknown Item\n' ..
'if string.find(MeshId, "' .. MeshId:match("%d+") .. '", 1, true) then' ..
Extra ..
'\n\treturn "UnknownItem"\nend\n'
	end

	if CopiedUnknownItems[Code] then
		return
	end

	CopiedUnknownItems[Code] = true

	setclipboard(Code)

	print(Code)
